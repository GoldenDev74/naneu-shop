# Copier en .env (chmod 600) dans ~/naneu-shop/surveillance/ et remplir.
GRAFANA_DOMAINE=surveillance.naneushop.com
GRAFANA_ADMIN=naneu-admin
# Mot de passe long et unique (ex. : openssl rand -base64 24).
GRAFANA_MOT_DE_PASSE=
# Clé API Resend « Sending access » (la même que MAIL_PASSWORD de l'application).
RESEND_CLE=
# Destinataire des alertes de surveillance.
ALERTES_EMAIL=
