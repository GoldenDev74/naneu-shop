# Modèle du .env de PRODUCTION (VPS, https://naneushop.com).
#
# Sur le VPS : copier ce fichier en .env, puis remplir les valeurs vides.
# Le vrai .env ne quitte jamais le VPS et n'est jamais commité.
#
# Secrets à générer sur le VPS :
#   APP_KEY                      php artisan key:generate --show
#   DB_PASSWORD, REVERB_APP_KEY / REVERB_APP_SECRET
#                                openssl rand -hex 24
#   MAIL_PASSWORD                clé API Resend (resend.com › API keys,
#                                permission « Sending access », domaine naneushop.com)

# Version de l'image à faire tourner (voir docker-compose.prod.yml).
# « latest » = dernière version de main ; « sha-xxxxxxx » ou « 1.2.3 » pour figer.
NANEU_IMAGE_TAG=latest

APP_NAME="Naneu Shop"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Africa/Lome
APP_URL=https://naneushop.com

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=30
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=pgsql
# Nom du service dans le réseau Docker.
DB_HOST=db
DB_PORT=5432
DB_DATABASE=naneu_shop
DB_USERNAME=naneu
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Le site n'est servi qu'en HTTPS : le cookie de session ne part jamais en clair.
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# --- Reverb (WebSocket temps réel) ---
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
# Les conteneurs publient vers Reverb par le réseau Docker.
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

# Adresse de Reverb vue par le navigateur (Apache relaie le WebSocket en 443).
# Ces variables VITE_ sont figées dans le JavaScript à la CONSTRUCTION de
# l'image : les changer ici ne suffit pas, il faut reconstruire l'image.
VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST=naneushop.com
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https

# --- Fichiers (photos produits, bons scannés, exports) ---
# Disque du VPS (volume Docker « storage-app »), servis par l'application
# via des liens signés de courte durée. À inclure dans les sauvegardes.
NANEU_STORAGE_DISK=local
NANEU_STORAGE_SIGNING_DISK=local

# --- E-mails : Resend, domaine naneushop.com vérifié (DKIM + SPF) ---
# alertes@naneushop.com n'est pas une boîte : les réponses sont redirigées
# vers naneushop@naneushop.com (redirection OVH).
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=smtp.resend.com
MAIL_PORT=465
MAIL_USERNAME=resend
MAIL_PASSWORD=
MAIL_EHLO_DOMAIN=naneushop.com
MAIL_FROM_ADDRESS="alertes@naneushop.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Métier Naneu Shop ---
NANEU_CURRENCY=XOF
NANEU_VAT_RATE=18
NANEU_VAT_ENABLED=false
NANEU_CONSUMPTION_STRATEGY=fifo
NANEU_EXPIRY_ALERT_DAYS=30
NANEU_LOW_STOCK_CHECK_TIME=07:00

# --- Sécurité du trafic ---
# Accès réservé au Togo (base : deploy/maj-geoip.sh -> /var/lib/naneu-geoip,
# montée dans /geoip). Mettre à true une fois la base téléchargée.
NANEU_GEO_ENABLED=false
NANEU_GEO_COUNTRIES=TG
NANEU_GEOIP_DB=/geoip/pays.mmdb
# Requêtes par minute : visiteur non connecté (par IP) / compte connecté.
NANEU_RATE_GUEST=60
NANEU_RATE_USER=300
# Conservation des journaux requetes-*.log et securite-*.log (jours).
NANEU_SECURITY_LOG_DAYS=90
