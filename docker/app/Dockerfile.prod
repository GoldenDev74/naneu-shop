# Image de PRODUCTION de Naneu Shop — construite par GitHub Actions, jamais
# sur le VPS. Elle contient le code, les dépendances PHP sans les outils de
# développement et le JavaScript/CSS compilé. Elle ne contient aucun secret :
# le .env est fourni au conteneur par docker-compose.prod.yml.

# --- Base commune : PHP 8.4 + FrankenPHP + extensions ----------------------
FROM dunglas/frankenphp:1-php8.4 AS base

RUN install-php-extensions pdo_pgsql pgsql gd zip intl bcmath pcntl exif opcache

WORKDIR /app

# --- Dépendances PHP (sans les paquets de développement) -------------------
FROM base AS vendor

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer
COPY composer.json composer.lock ./
RUN composer install --no-dev --no-interaction --no-scripts --no-autoloader --prefer-dist

# --- JavaScript et CSS compilés --------------------------------------------
FROM node:22-alpine AS assets

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY vite.config.js tailwind.config.js postcss.config.js ./
COPY resources ./resources
# Tailwind lit ces dossiers pour savoir quelles classes garder.
COPY app ./app
COPY --from=vendor /app/vendor/laravel/framework/src/Illuminate/Pagination/resources/views \
    ./vendor/laravel/framework/src/Illuminate/Pagination/resources/views

# Adresse du WebSocket vue par le navigateur : figée dans le JavaScript ici.
# La clé Reverb est publique (elle est envoyée au navigateur) mais doit être
# la même que REVERB_APP_KEY dans le .env du VPS.
ARG VITE_APP_NAME="Naneu Shop"
ARG VITE_REVERB_APP_KEY
ARG VITE_REVERB_HOST=naneushop.com
ARG VITE_REVERB_PORT=443
ARG VITE_REVERB_SCHEME=https

RUN test -n "$VITE_REVERB_APP_KEY" || (echo "VITE_REVERB_APP_KEY est vide : le temps réel ne marcherait pas." && exit 1)
RUN npm run build

# --- Image finale ------------------------------------------------------------
FROM base

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer
RUN cp "$PHP_INI_DIR/php.ini-production" "$PHP_INI_DIR/php.ini"
COPY docker/app/php.prod.ini $PHP_INI_DIR/conf.d/naneu.ini

# HTTP simple sur le port 80 du conteneur : c'est Apache, sur le VPS, qui
# porte le certificat et relaie les requêtes.
ENV SERVER_NAME=:80

COPY . .
COPY --from=vendor /app/vendor ./vendor
COPY --from=assets /app/public/build ./public/build

# package:discover démarre l'application sans .env : sans DB_CONNECTION,
# Laravel tenterait d'ouvrir une base SQLite qui n'existe pas.
RUN mkdir -p storage/app/private storage/app/public storage/logs bootstrap/cache \
        storage/framework/views storage/framework/cache/data storage/framework/sessions \
    && DB_CONNECTION=pgsql composer dump-autoload --no-dev --optimize --no-interaction \
    && chmod +x docker/app/entrypoint.prod.sh

HEALTHCHECK --interval=30s --timeout=5s --start-period=40s --retries=3 \
    CMD curl -fsS http://localhost/up || exit 1

ENTRYPOINT ["/app/docker/app/entrypoint.prod.sh"]
# Redéfinir ENTRYPOINT efface la commande héritée : on la répète à l'identique.
CMD ["--config", "/etc/frankenphp/Caddyfile", "--adapter", "caddyfile"]
